# Desenvolvimento local
DEBUG=True
SECRET_KEY=chaveradar-chave-local-desenvolvimento

# Deixe vazio para usar SQLite local.
# No Render, configure com a URI do Session pooler do Supabase.
DATABASE_URL=

# Futuro dominio proprio, se necessario:
DJANGO_ALLOWED_HOSTS=

# Bootstrap inicial de administrador no Render.
# Use somente como variaveis secretas no Render, nunca com valores reais no GitHub.
CHAVERADAR_ADMIN_USERNAME=
CHAVERADAR_ADMIN_EMAIL=
CHAVERADAR_ADMIN_PASSWORD=
